DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pilates_studio"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pilates_studio"

# Supabase + Prisma mapping (optional)
# Set DATABASE_URL to Supabase pooled Prisma URL
# Set DIRECT_URL to Supabase non-pooling URL
# Example:
# DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# Public app URL used for production metadata and deployment checks.
# In Vercel production, set this to your primary domain, for example:
# APP_URL="https://admin.reformpilates.vn"
# If omitted, the app can fall back to Vercel system URLs in preview/production.
APP_URL="http://localhost:3000"

# App / locale
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# Seeded admin password used by `npm run db:seed`
SEED_ADMIN_DEFAULT_PASSWORD="Pilates123!"

# Optional scheduled route secret if you later add an external scheduler or Vercel Cron
CRON_SECRET=""

# Optional Google Calendar sync
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID=""
GOOGLE_IMPERSONATED_USER=""
GOOGLE_DELETE_CANCELLED_EVENTS="false"
